# Copy to .env in this directory for local Edge Function development.
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY at runtime.
# Keep actual credentials in the ignored .env file or hosted Function Secrets.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_REDIRECT_URI=http://localhost:3000/snapTradeRedirect
POSTMARK_SERVER_TOKEN=
FROM_EMAIL=
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_DB_SCHEMA=public
