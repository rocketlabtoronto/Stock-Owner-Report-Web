# Copy to .env.development.local for npm start.
# Copy to .env.production.local for a local production build, or configure the host.
# Every REACT_APP_* value is embedded in the public browser bundle.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: leave these blank when Stripe checkout is not configured.
REACT_APP_STRIPE_PRICING_TABLE_ID=
REACT_APP_STRIPE_PUBLISHABLE_KEY=

REACT_APP_DISABLE_SNAPTRADE=false
REACT_APP_FAKE_EQUITY=false
